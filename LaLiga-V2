import matplotlib.pyplot as plt

estudiantes = {}

try:
    numEstudiantes = int(input("Introduzca el numero de estudiantes: "))
    
    for i in range(numEstudiantes):
        nomEst = input(f"Nombre del estudiante {i+1}: ")
        golesEst = int(input("Introduzca el numero de goles: "))
        minutosEst = int(input("Introduzca el numero de minutos jugados: "))
        
        puntos = golesEst * 2
        
        
        if minutosEst != 0:
            promedioGoles = golesEst / minutosEst
        else:
            promedioGoles = 0
        
    
        estudiantes[nomEst] = {
            "goles": golesEst,
            "puntos": puntos,
            "minutos": minutosEst,
            "promedio": promedioGoles
        }

except ValueError:
    print("Numero no valido...")

finally:
    
    # Guardar en archivo
    with open("LaLiga.txt", "w") as fliga:
        for nombre, datos in estudiantes.items():
            fliga.write(
                f"{nombre} - "
                f"Goles: {datos['goles']}, "
                f"Puntos: {datos['puntos']}, "
                f"Minutos: {datos['minutos']}, "
                f"Promedio: {datos['promedio']:.4f}\n"
            )

    
    with open("LaLiga.txt", "r") as flectura:
        texto = flectura.read()
        print("\nContenido del archivo:")
        print(texto)


if len(estudiantes) > 0:
    nombres = list(estudiantes.keys())
    goles = [datos["goles"] for datos in estudiantes.values()]

    plt.figure()
    plt.bar(nombres, goles)
    plt.xlabel("Estudiantes")
    plt.ylabel("Goles")
    plt.title("Goles por Estudiante")
    plt.show()
else:
    print("No hay datos para graficar.")
